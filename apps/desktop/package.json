{
  "name": "@tethera/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Tethera desktop sync client",
  "author": "Tethera <noreply@tdanks.com>",
  "homepage": "https://github.com/tethera-sync/tethera",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "electron:install": "install-electron --no",
    "test": "bun test tests",
    "dist": "electron-vite build && electron-builder --config electron-builder.yml --publish=never",
    "dist:mac": "electron-vite build && electron-builder --config electron-builder.yml --mac --publish=never",
    "dist:win": "electron-vite build && electron-builder --config electron-builder.yml --win --publish=never",
    "dist:linux": "electron-vite build && electron-builder --config electron-builder.yml --linux --publish=never"
  },
  "dependencies": {
    "@base-ui/react": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-virtual": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "electron-updater": "^6.8.9",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "latest",
    "tailwind-merge": "latest",
    "zod": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "electron-vite": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
